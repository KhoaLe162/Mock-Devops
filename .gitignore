# Terraform downloaded providers and modules
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json